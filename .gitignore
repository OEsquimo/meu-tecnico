# Dependências instaladas (são recriadas com "npm install")
node_modules/

# A configuração web do Firebase (public/js/configuracao/firebase-config.js) FICA no repositório:
# o app é publicado pelo GitHub Pages e precisa desse arquivo no ar. A chave web NÃO é secreta;
# quem protege os dados são o login e as regras do Firestore (firestore.rules).

# Credenciais PRIVADAS — jamais versionar
.env
.env.*
*.pem
*.key
serviceAccount*.json
*-adminsdk-*.json

# Estado local do Firebase CLI
.firebase/
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log

# Relatórios e temporários
coverage/
test-results/
playwright-report/
*.log
.DS_Store
